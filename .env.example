# --- OpenRouter (optional) -------------------------------------------------
#
# Powers the conversational search (جستجوی هوشمند): the Persian chat replies
# and the intent extraction that turns a sentence into filters. Leave it at the
# placeholder and the app runs fine -- the classic filter panel, the map, the
# ranking and the scores are computed entirely locally and are byte-identical
# either way. The AI mode is simply reported as unavailable through
# GET /api/v1/config and shown disabled in the header.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-chat

# Description embeddings, billed to the same account. Only the corpus-building
# scripts use these; with no key they fall back to a local hashing vectorizer.
EMBEDDING_MODEL=openai/text-embedding-3-small

# Tehran Geospatial Limits
DEFAULT_LAT=35.6997
DEFAULT_LON=51.3380

# --- Features --------------------------------------------------------------
#
# کاوش نقشه, the free-roam map mode: pan or zoom and every listing inside the
# viewport comes back, filters ignored. Set to False and the header drops the
# mode altogether -- the map itself stays, as the panel beside the classic
# filters; only the standalone explore mode goes away.
EXPLORE_MAP_ENABLED=True

# Environment
APP_ENV=development
DEBUG=True
