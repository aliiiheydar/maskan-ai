# Provider 1 -- embeddings (EMBEDDING_MODEL is served from this account).
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Provider 2 -- chat/intent completions (LLM_MODEL is served from this
# account). Leave blank to run both through provider 1 instead.
OPENROUTER2_API_KEY=your_second_provider_api_key_here
OPENROUTER2_BASE_URL=https://agentrouter.org/v1

LLM_MODEL=deepseek-v4-flash
LLM_FALLBACK_MODEL=deepseek/deepseek-chat
EMBEDDING_MODEL=openai/text-embedding-3-small

# Tehran Geospatial Limits
DEFAULT_LAT=35.6997
DEFAULT_LON=51.3380

# Environment
APP_ENV=development
DEBUG=True