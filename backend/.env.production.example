# Backend configuration -- production.
#
#     cp backend/.env.production.example backend/.env.production
#
# Read by docker-compose.yml's env_file. Differences from .env.example are the
# point of the file: debug off, a real origin instead of localhost, and the
# corpus on the mounted volume.

# --- OpenRouter (optional) -------------------------------------------------
#
# Without a real key the deployment serves the filter panel, the map and the
# full ranking exactly as it would with one; only جستجوی گفت‌وگویی is reported
# unavailable through GET /api/v1/config. Nothing else degrades.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-chat
EMBEDDING_MODEL=openai/text-embedding-3-small

# --- Data ------------------------------------------------------------------
#
# The mounted volume, not the package directory: the corpus has to outlive the
# image. docker-compose.yml sets this too, so it is here to be read rather
# than to be relied on.
DB_PATH=/data/maskan.db

# --- Web -------------------------------------------------------------------
#
# The origin the frontend is actually served from. A wildcard is not accepted
# and localhost is not it -- a wrong value here fails as CORS errors in the
# browser while the API itself answers perfectly.
CORS_ALLOW_ORIGINS=https://maskan.example.com

DEFAULT_LAT=35.6997
DEFAULT_LON=51.3380

# --- Features --------------------------------------------------------------
EXPLORE_MAP_ENABLED=True

APP_ENV=production
DEBUG=False
