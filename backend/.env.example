# Backend configuration -- development.
#
#     cp backend/.env.example backend/.env
#
# Read by app/core/config.py (pydantic-settings) and, in a container, handed
# to the process by docker-compose.dev.yml's env_file. Real environment
# variables win over this file, which is how the compose files override
# DB_PATH without editing it.
#
# Copy backend/.env.production.example instead for a deployment.

# --- OpenRouter (optional) -------------------------------------------------
#
# Powers the conversational search (جستجوی گفت‌وگویی): the Persian chat replies
# and the intent extraction that turns a sentence into filters. Leave it at the
# placeholder and the app runs fine -- the filter panel, the map, the ranking
# and the match scores are computed entirely locally and are byte-identical
# either way. The conversational mode is simply reported as unavailable through
# GET /api/v1/config and shown disabled in the header.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# The leading ~ is part of the OpenRouter id, not a typo: it marks a floating
# "latest" alias, which today resolves to deepseek-v4-flash-0731.
LLM_MODEL=~deepseek/deepseek-v4-flash-latest

# Description embeddings, billed to the same account. Only the corpus-building
# scripts use these; with no key they fall back to a local hashing vectorizer.
EMBEDDING_MODEL=openai/text-embedding-3-small

# --- Data ------------------------------------------------------------------
#
# Where the SQLite corpus lives. Empty means the default inside the package
# (app/data/assets/maskan.db), which is what you want when running from a
# checkout. The compose files set it to a mounted volume instead.
DB_PATH=

# --- Web -------------------------------------------------------------------
#
# Browsers allowed to call this API, comma-separated. The frontend is always a
# different origin, so there is always at least one.
CORS_ALLOW_ORIGINS=http://localhost:3000

# Tehran geospatial defaults -- where the map opens.
DEFAULT_LAT=35.6997
DEFAULT_LON=51.3380

# --- Features --------------------------------------------------------------
#
# کاوش نقشه, the free-roam map mode: pan or zoom and every listing inside the
# viewport comes back, filters ignored. Set to False and the header drops the
# mode altogether -- the map itself stays, as the panel beside the filters;
# only the standalone explore mode goes away.
EXPLORE_MAP_ENABLED=False

# Environment
APP_ENV=development
DEBUG=True
