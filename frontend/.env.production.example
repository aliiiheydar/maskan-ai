# Frontend configuration -- production.
#
#     cp frontend/.env.production.example frontend/.env.production
#
# Read by `next build`, which inlines these into the bundle. docker compose
# also passes NEXT_PUBLIC_API_BASE_URL as a build argument; that argument wins
# when it is set, and this file is the fallback.
#
# Because the value is compiled in, changing it means rebuilding the image:
#
#     docker compose build frontend && docker compose up -d frontend

# The public address of the API, as the user's browser will resolve it.
NEXT_PUBLIC_API_BASE_URL=https://api.maskan.example.com/api/v1
