# Frontend configuration -- development.
#
#     cp frontend/.env.example frontend/.env
#
# Only NEXT_PUBLIC_* variables exist here, and that is not an accident: this
# app has no server-side secrets. Everything it knows it asks the backend for.
#
# NEXT_PUBLIC_* values are compiled into the JavaScript bundle, so `next dev`
# picks a change up on restart and a production image needs a rebuild -- see
# frontend/.env.production.example.

# Where the browser reaches the API. Not where the *container* reaches it:
# this address is resolved on the user's machine, so a Docker service name
# ("http://backend:8000") would not work here even though the containers can
# use it between themselves.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
